      "    println!(sw_status(true, methods, \"DELETE\"));",
      "    println!(sw_status(false, methods, \"GET\"));",
      "\\}"
    ]
  },
  "Swiftlet — sw_flag": {
    "prefix": "blyx-swiftlet-sw_flag",
